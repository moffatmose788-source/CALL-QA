# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Server ──────────────────────────────────────────────
PORT=4000
UPLOAD_DIR=./uploads

# ── Whisper (audio transcription) ──────────────────────
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# Force a language instead of auto-detect: en | sw (leave blank for auto)
WHISPER_LANGUAGE=

# ── Scoring defaults ────────────────────────────────────
DEPARTMENT=Recovery
SAMPLE_SIZE=5
PASS_THRESHOLD=70

# ── CRM / customer portal (optional) ───────────────────
CRM_BASE_URL=
CRM_API_KEY=
# phone | custid | account
CRM_MATCH_FIELD=phone
CRM_FIELD_NAME=customer.full_name
CRM_FIELD_ID=customer.id
CRM_FIELD_PHONE=customer.phone_primary
CRM_FIELD_BALANCE=account.balance_kes
CRM_FIELD_PRODUCT=product.name
CRM_FIELD_AGENT=agent.employee_id
